{
  "name": "dynamo-gui",
  "version": "2.1.0",
  "author": "Renato Asterio",
  "license": "UNLICENSED",
  "description": "Visual GUI tool for AWS DynamoDB — query, insert, update & delete items",
  "main": "electron-main.js",
  "scripts": {
    "test": "jest --verbose",
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "build": "electron-builder --mac --arm64",
    "build:universal": "electron-builder --mac --universal",
    "build:win": "electron-builder --win --x64",
    "build:win:all": "electron-builder --win --x64 --ia32",
    "build:prod:mac": "node scripts/build-prod.js --mac --arm64",
    "build:prod:mac:universal": "node scripts/build-prod.js --mac --universal",
    "build:prod:win": "node scripts/build-prod.js --win --x64",
    "build:prod:all": "node scripts/build-prod.js --mac --arm64 --win --x64",
    "icons": "node scripts/generate-icons.js"
  },
  "build": {
    "appId": "com.dynamoops.app",
    "productName": "DynamoOps",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/icon.icns"
    },
    "dmg": {
      "title": "DynamoOps",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DynamoOps",
      "installerHeaderIcon": "assets/icons/icon.ico"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "preload.js",
      ".env.production",
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1020.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-dynamodb-streams": "^3.1014.0",
    "@aws-sdk/client-sts": "^3.738.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "jose": "^6.2.2",
    "multer": "^1.4.5-lts.2",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "javascript-obfuscator": "^5.4.1",
    "jest": "^30.3.0"
  }
}
